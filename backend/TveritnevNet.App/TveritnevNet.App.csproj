<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ContentTargetFolders>content</ContentTargetFolders>
        <TargetFramework>net10.0</TargetFramework>
        <Authors>Artpupser, Neitan</Authors>
        <OutputType>Exe</OutputType>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
        <Description>TveritnevNet - lending for anatoly tveritnev</Description>
        <RootNamespace>TveritnevNet.App</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="**\*" Exclude="bin\**;obj\**" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <FilesProject Include="$(ProjectDir)/environment/**/*" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="dotenv.net" Version="4.0.2" />
        <PackageReference Include="Npgsql" Version="10.0.2" />
        <PackageReference Include="PupaMVCF.Framework" Version="0.2.0" />
    </ItemGroup>
    <Target Name="BuildEnv" AfterTargets="Build">
        <Copy SourceFiles="@(FilesProject)" DestinationFolder="$(TargetDir)/%(RecursiveDir)" />
    </Target>
    <Target Name="PublishEnv" AfterTargets="Publish">
        <Copy SourceFiles="@(FilesProject)" DestinationFolder="$(PublishDir)/%(RecursiveDir)" />
    </Target>
</Project>
