---

<MainLayout
  title={pageDataFromBackend.config.title}
  showHeader={pageDataFromBackend.config.showHeader}
  showFooter={pageDataFromBackend.config.showFooter}
>
  {
    pageDataFromBackend.sections.map((section) => (
      <SectionRenderer section={section} />
    ))
  }
</MainLayout>
