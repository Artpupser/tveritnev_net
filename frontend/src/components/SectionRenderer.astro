---
import Hero from "@sections/Hero";
import About from "@sections/About";
import ServiceSwitcher from "@sections/ServiceSwitcher";
import Reviews from "@sections/Reviews";
import FAQ from "@sections/FAQ";
import type { SectionData } from "@appTypes/landing";

interface Props {
  section: SectionData;
}

const { section } = Astro.props;
---

{section.type === "hero" && <Hero {...section.props} />}
{section.type === "about" && <About {...section.props} />}
{
  section.type === "serviceSwitcher" && (
    <ServiceSwitcher {...section.props} client:load />
  )
}
{section.type === "reviews" && <Reviews {...section.props} />}
{section.type === "faq" && <FAQ {...section.props} client:load />}
